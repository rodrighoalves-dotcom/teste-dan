{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "3.2.14",
  "description": "__MSG_extensionDescription__",
  "default_locale": "pt_BR",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "downloads",
    "tabs"
  ],
  "host_permissions": [
    "https://www.goawakecloud.com.br/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_extensionName__",
    "default_icon": {
      "16": "assets/icons/icon.png",
      "48": "assets/icons/icon.png",
      "128": "assets/icons/icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.goawakecloud.com.br/*"
      ],
      "js": [
        "content/audit-pagination-guard.js",
        "content/fatigue-pagination-guard.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.goawakecloud.com.br/*"
      ],
      "js": [
        "shared/config.js",
        "shared/logger.js",
        "shared/sla-summary-calculator.js",
        "shared/company-preselection.js",
        "content/report-print.js",
        "content/report-runtime-v2.js",
        "content/automatic-author-popup.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icons/icon.png"
      ],
      "matches": [
        "https://www.goawakecloud.com.br/*"
      ]
    }
  ],
  "icons": {
    "16": "assets/icons/icon.png",
    "48": "assets/icons/icon.png",
    "128": "assets/icons/icon.png"
  }
}
